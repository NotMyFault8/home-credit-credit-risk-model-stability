            <column name="[applications]" datatype="real" role="measure" type="quantitative" />
            <column-instance column="[applications]" derivation="Avg" name="[avg:applications:qk]" pivot="key" type="quantitative" />
            <column name="[mode]" datatype="string" role="dimension" type="nominal" />
            <column-instance column="[mode]" derivation="None" name="[none:mode:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
